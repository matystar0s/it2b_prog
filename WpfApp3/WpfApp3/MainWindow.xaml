<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="Button" Content="Click Me!" HorizontalAlignment="Center" Margin="0,106,0,0" VerticalAlignment="Top" Height="39" Width="86" Click="Button_Click"/>
        <ProgressBar x:Name="Bar" HorizontalAlignment="Center" Height="34" Margin="0,16,0,0" VerticalAlignment="Top" Width="740" Minimum="0" Maximum="10000000" Value="0" />
        <TextBlock x:Name="Clicks" HorizontalAlignment="Left" Margin="30,80,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="cs-cz" Text="clicks: "/></TextBlock>
        <Button Content="Clicks upgrade&#xD;&#xA;100 clicks" HorizontalAlignment="Left" Margin="29,124,0,0" VerticalAlignment="Top" Height="46" Click="Button_Click_1" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.093"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <TextBlock x:Name="Power" HorizontalAlignment="Left" Margin="30,64,0,0" TextWrapping="Wrap" Text="Click power: 1" VerticalAlignment="Top"/>
        <Button Content="Clicks upgrade&#xA;1000 clicks" HorizontalAlignment="Left" Margin="30,186,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
        <Button Content="Clicks upgrade&#xA;10000 clicks" HorizontalAlignment="Left" Margin="30,240,0,0" VerticalAlignment="Top" Click="Button_Click_3"/>
        <TextBlock x:Name="_10000" HorizontalAlignment="Left" Margin="129,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="65"/>
        <TextBlock x:Name="_1000" HorizontalAlignment="Left" Margin="129,196,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock x:Name="_100" HorizontalAlignment="Left" Margin="129,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="92"/>
    </Grid>
</Window>
